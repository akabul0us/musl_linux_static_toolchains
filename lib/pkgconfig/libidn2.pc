prefix=/opt/toolchains/arm-linux-musleabi-cross
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: libidn2
Description: Library implementing IDNA2008 and TR46
Version: 2.3.8
Cflags: -I${includedir}
Libs: -L${libdir} -lidn2
Libs.private: -L/opt/toolchains/arm-linux-musleabi-cross/lib -liconv -L/opt/toolchains/arm-linux-musleabi-cross/lib -lunistring -L/opt/toolchains/arm-linux-musleabi-cross/lib -liconv
