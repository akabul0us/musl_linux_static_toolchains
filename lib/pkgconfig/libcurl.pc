prefix=/opt/toolchains/arm-linux-musleabihf-cross
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT POP3 POP3S RTSP SCP SFTP SMB SMBS SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IPv6 Largefile libz NTLM PSL SSL threadsafe TLS-SRP UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.17.0
Requires: zlib,libzstd,openssl,libpsl,libssh2
Requires.private: zlib,libzstd,openssl,libpsl,libssh2
Libs: -L${libdir} -lcurl -lssh2 -lssh2 -lpsl -lssl -lcrypto -lssl -lcrypto -lzstd  -lz 
Libs.private: -L/opt/toolchains/arm-linux-musleabihf-cross/lib -lssh2 -lssh2 -lpsl -lssl -lcrypto -lssl -lcrypto -lzstd -lz
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
