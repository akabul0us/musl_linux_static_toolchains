prefix=/opt/toolchains/arm-linux-musleabihf-cross
exec_prefix=${prefix}
libdir=/opt/toolchains/arm-linux-musleabihf-cross/lib
sharedlibdir=${libdir}
includedir=/opt/toolchains/arm-linux-musleabihf-cross/include

Name: zlib
Description: zlib compression library
Version: 1.3.1

Requires:
Libs: -L${libdir} -L${sharedlibdir} -lz
Cflags: -I${includedir}
