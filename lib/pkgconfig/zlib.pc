prefix=/opt/toolchains/aarch64-linux-musl-cross
exec_prefix=${prefix}
libdir=/opt/toolchains/aarch64-linux-musl-cross/lib
sharedlibdir=${libdir}
includedir=/opt/toolchains/aarch64-linux-musl-cross/include

Name: zlib
Description: zlib compression library
Version: 1.3.1

Requires:
Libs: -L${libdir} -L${sharedlibdir} -lz
Cflags: -I${includedir}
