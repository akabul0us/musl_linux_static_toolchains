prefix=/opt/toolchains/mips-linux-muslsf-cross
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
 
Name: libverto-glib
Description: Event loop abstraction interface (glib module)
Version: 0.3.2
Libs: -L${libdir} -lverto-glib
Cflags: -I${includedir}
Requires.private: libverto
