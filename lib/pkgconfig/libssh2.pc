prefix=/opt/toolchains/mipsel-linux-muslsf-cross
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: libcrypto,zlib
Requires.private: libcrypto,zlib
Libs: -L${libdir} -lssh2  -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lssl -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lcrypto -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lz
Libs.private:  -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lssl -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lcrypto -L/opt/toolchains/mipsel-linux-muslsf-cross/lib -lz
Cflags: -I${includedir}
